{
  "name": "areqa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:store": "npm run dev -w @areqa/store",
    "dev:admin": "npm run dev -w @areqa/admin",
    "build": "npm run build -w @areqa/store && npm run build -w @areqa/admin",
    "build:store": "npm run build -w @areqa/store",
    "build:admin": "npm run build -w @areqa/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "tsx scripts/seed/index.ts",
    "emulators": "firebase emulators:start --project areqa-store",
    "seed:emulator": "tsx scripts/seed/index.ts --emulator",
    "test": "vitest run --exclude 'tests/rules/**'",
    "test:rules": "firebase emulators:exec --only firestore --project demo-areqa-test 'vitest run tests/rules'"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "firebase-admin": "^13.0.2",
    "firebase-tools": "^14.27.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
