# ── Firebase (Project settings → General → Your apps → Web app) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Use local emulators (npm run emulators) instead of the real project
VITE_FIREBASE_EMULATOR=false
VITE_FIREBASE_APP_ID=
# Optional — enables Google Analytics 4 e-commerce events via Firebase Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# ── Site ──
VITE_SITE_URL=https://areqa.vercel.app
# Fallback WhatsApp number if settings/store has none (format 2547XXXXXXXX)
VITE_WHATSAPP_NUMBER=254700000000

# ── Cloudinary (only the cloud name is needed on the storefront) ──
VITE_CLOUDINARY_CLOUD_NAME=

# ── EmailJS (leave blank to disable emails — orders still work) ──
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_CUSTOMER=
VITE_EMAILJS_TEMPLATE_STORE=

# ── Optional integrations (blank = off) ──
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=
VITE_CLARITY_PROJECT_ID=
VITE_RECAPTCHA_SITE_KEY=
VITE_ENABLE_VERCEL_ANALYTICS=true
