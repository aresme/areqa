# ── Firebase — same project as the storefront ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Use local emulators (npm run emulators) instead of the real project
VITE_FIREBASE_EMULATOR=false
VITE_FIREBASE_APP_ID=

# ── Cloudinary (Settings → Upload → Upload presets → unsigned) ──
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=areqa_unsigned
VITE_CLOUDINARY_FOLDER=areqa

# ── EmailJS — status-update emails to customers ──
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_CUSTOMER=

# Public storefront URL (used for links in emails and "view on store")
VITE_STORE_URL=https://areqa.vercel.app
